# Copy to deploy/.env.deploy (gitignored) and fill in. ./deploy/deploy.sh reads it and writes
# generated values back into it, so keep the file: BOOTH_CODE_SECRET decides every booth's QR code.

# ---- Kubernetes ----
# Must match `namespace:` in deploy/k8s/kustomization.yaml (change both through a PR if the organizers gave you another one).
NAMESPACE=salty-cluster
# Install Argo CD if the cluster doesn't have it: auto | yes | no
INSTALL_ARGOCD=auto

# ---- Elasticsearch (Elastic Cloud: deployment/project page -> "Copy endpoint") ----
ES_URL=https://<id>.<region>.cloud.es.io:443
# Serverless projects (*.elastic.cloud): leave the admin fields empty and paste an API key below; run
# `./deploy/deploy.sh elastic` with ES_API_KEY empty to print the exact privileges to give it.
# Hosted deployments: give admin credentials once (the `elastic` user from deployment creation) and the
# script creates a least-privilege API key for the app...
ES_ADMIN_USER=elastic
ES_ADMIN_PASSWORD=
# ...or paste an existing API key (the "encoded" value). The script fills this in after creating one.
ES_API_KEY=

# ---- Dash0 (Settings -> Endpoints / Auth Tokens) ----
# OTLP via gRPC, host:port, used by the collector in the cluster
DASH0_OTLP_ENDPOINT=ingress.<region>.aws.dash0.com:4317
# Ingesting token for the collector
DASH0_AUTH_TOKEN=
# Browser monitoring (optional): OTLP via HTTP URL + an ingest-only token limited to the dataset.
# `./deploy/deploy.sh github` stores these as GitHub Actions variables for the image build.
VITE_DASH0_ENDPOINT=
VITE_DASH0_AUTH_TOKEN=

# ---- App secrets (left empty = generated once and saved here) ----
ORGANIZER_TOKEN=
PLAYER_SALT=
BOOTH_CODE_SECRET=

# ---- Public URL (optional) ----
# ingress | loadbalancer | none (none = use port-forward)
EXPOSE=none
PUBLIC_HOST=
INGRESS_CLASS=nginx

# ---- Only if the ghcr.io images are private ----
GHCR_USER=
GHCR_TOKEN=
